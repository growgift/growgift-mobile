# Copy to .env (never commit .env). Values are public app settings, not secrets.
# iOS simulator:     http://localhost:8080/api/v1
# Android emulator:  http://10.0.2.2:8080/api/v1
# Physical device:   http://<your-computer-LAN-IP>:8080/api/v1
EXPO_PUBLIC_API_BASE=http://localhost:8080/api/v1
# The website, used for the identity form and Stripe return pages:
EXPO_PUBLIC_WEB_BASE=http://localhost:3000
