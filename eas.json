{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_BASE": "https://dev-api.example.com/api/v1", "EXPO_PUBLIC_WEB_BASE": "https://dev.example.com" }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "env": { "EXPO_PUBLIC_API_BASE": "https://staging-api.example.com/api/v1", "EXPO_PUBLIC_WEB_BASE": "https://staging.example.com" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_BASE": "https://api.example.com/api/v1", "EXPO_PUBLIC_WEB_BASE": "https://www.example.com" }
    }
  },
  "submit": { "production": {} }
}
